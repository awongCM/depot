<% if notice.present? %>
  <p id="notice"><%= notice %></p>
<% end %>

<h1><%=t('.title_html')%></h1>

<% cache ['store', Product.latest] do %>
  <%  @products.each do |product| %>
    <% cache ['entry', product] do %>
    <div class="entry" data-controller="add-to-cart">
      <%= image_tag(product.image_url, data: { action: "click->add-to-cart#add" }) %>
        <h3><%= product.title %></h3>
      <%= sanitize(product.description) %>
      <div class="price_line">
        <span class="price"><%= currency_to_locale(product.price) %></span>
        <%= button_to t('.add_html'), line_items_path(product_id: product), remote: true, data: { turbo: false } %>
      </div>
    </div>
    <% end %>
  <% end %>
<% end %>