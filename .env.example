# Copy to .env and fill in values for local development.
# Never commit .env to version control.

# SMTP (optional — required only if you want to send real email in development)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=
SMTP_PASSWORD=

# Admin email for error notifications
ADMIN_EMAIL=dave@example.com

# Production only
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# PostgreSQL (optional — defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=depot
DB_PASSWORD=depot
